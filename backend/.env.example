# Copy this file to `backend/.env` and fill in values.
# NEVER commit `.env`. These keys are server-side only and must never reach the browser.

# --- Application ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
# true = one JSON object per log line
LOG_JSON=false

# --- Deepgram STT (Milestone 2) - https://console.deepgram.com ---
DEEPGRAM_API_KEY=

# --- Groq LLM (Milestone 3) - https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- ElevenLabs TTS (Milestone 4) - https://elevenlabs.io/app/settings/api-keys ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Supabase PostgreSQL (Milestone 6) - Project Settings > API / Database ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
