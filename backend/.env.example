# Copy this file to `backend/.env` and fill in values.
# NEVER commit `.env`. These keys are server-side only and must never reach the browser.

# --- Application ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
# true = one JSON object per log line
LOG_JSON=false

# --- Voice sessions ---
# Max simultaneous calls (kept low to protect free API quotas)
VOICE_MAX_CONCURRENT_SESSIONS=2
# Turn-taking: seconds of continuous voice that start the caller's turn / interrupt
# the assistant (higher ignores "mm-hmm" and coughs; lower stops it sooner)
VOICE_VAD_START_SECS=0.4
# Words that also interrupt the assistant while it speaks
VOICE_BARGE_IN_MIN_WORDS=2
# Pause (s) after which the caller's turn may end; shorter pauses continue the same turn
VOICE_TURN_END_SILENCE_SECS=0.4
# Silence before "Are you still there?" (the call ends after a second silence)
VOICE_SILENCE_PROMPT_SECS=8

# --- Deepgram STT (Milestone 2) - https://console.deepgram.com ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
# Empty = US default. api.eu.deepgram.com connected ~2x faster from South Asia in testing.
DEEPGRAM_BASE_URL=
# BCP-47 code: en, en-US, en-GB, en-IN ... or "multi" for multilingual code-switching
DEEPGRAM_LANGUAGE=en

# --- Groq LLM (Milestone 3) - https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order when GROQ_MODEL is rate-limited (each model has its own free-tier limit).
# Avoid openai/gpt-oss-20b: in testing it invented caller details.
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b
# low | medium | high. Higher = slower first word.
GROQ_REASONING_EFFORT=low

# --- ElevenLabs TTS (Milestone 4) - https://elevenlabs.io/app/settings/api-keys ---
# Restricted key is enough: Text to Speech (Access), Voices (Read), Models, User.
ELEVENLABS_API_KEY=
# Empty = premade voice "Sarah". Any premade voice ID from your Voices list works.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency, 0.5 credits per character
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Supabase PostgreSQL (Milestone 6) - https://supabase.com ---
# Project -> Connect -> "Session pooler" URI, with [YOUR-PASSWORD] replaced by the DB password:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Then create the tables and demo data:  uv run python -m app.db.migrate --seed
DATABASE_URL=
# The restaurant this deployment answers for (restaurants.slug from supabase/seed.sql)
RESTAURANT_SLUG=olive-and-ember

# --- Admin screens (Milestone 7) ---
# Password for the dashboard, reservations, settings and call logs (the live call page
# stays public). Unset = those screens are locked.
ADMIN_PASSWORD=
# Optional: signs the admin session cookie. Empty = derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
